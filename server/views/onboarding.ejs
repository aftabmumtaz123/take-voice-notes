<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Welcome · <%= (settings && settings.siteName) || 'AI Note Taker' %></title>
  <link rel="stylesheet" href="/public/auth.css" />
  <link rel="stylesheet" href="/public/onboarding-web.css" />
</head>
<body class="auth-body">
  <% const stepNum = Number(step || 1); %>
  <% const name = (user && (user.displayName || user.username)) || 'there'; %>
  <div class="auth-shell onb-shell">
    <a class="auth-logo" href="/">
      <span class="mark">✦</span>
      <strong><%= (settings && settings.siteName) || 'AI Note Taker' %></strong>
    </a>

    <% if (stepNum === 1) { %>
      <h1>Welcome, <%= name %>!</h1>
      <p class="auth-sub">A few questions to get started.</p>
      <div class="auth-panel onb-panel">
        <div class="onb-progress"><span class="done"></span><span></span><span></span></div>
        <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
        <form method="POST" action="/onboarding">
          <input type="hidden" name="step" value="1" />
          <p class="onb-q">What do you use <%= (settings && settings.siteName) || 'AI Note Taker' %> for?</p>
          <div class="onb-chips">
            <label class="chip-opt"><input type="radio" name="useCase" value="Study" required /><span>Study</span></label>
            <label class="chip-opt"><input type="radio" name="useCase" value="Work" /><span>Work</span></label>
            <label class="chip-opt"><input type="radio" name="useCase" value="Personal Projects" /><span>Personal Projects</span></label>
          </div>
          <button type="submit" class="auth-submit">Continue</button>
        </form>
      </div>
    <% } else if (stepNum === 2) { %>
      <h1>Almost there</h1>
      <p class="auth-sub">Help us understand how people find us.</p>
      <div class="auth-panel onb-panel">
        <div class="onb-progress"><span class="done"></span><span class="done"></span><span></span></div>
        <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
        <form method="POST" action="/onboarding">
          <input type="hidden" name="step" value="2" />
          <p class="onb-q">Where did you hear about us?</p>
          <div class="onb-chips">
            <label class="chip-opt"><input type="radio" name="heardFrom" value="Google" required /><span>Google</span></label>
            <label class="chip-opt"><input type="radio" name="heardFrom" value="Friend / Colleague" /><span>Friend / Colleague</span></label>
            <label class="chip-opt"><input type="radio" name="heardFrom" value="Twitter / X" /><span>Twitter / X</span></label>
            <label class="chip-opt"><input type="radio" name="heardFrom" value="LinkedIn" /><span>LinkedIn</span></label>
            <label class="chip-opt"><input type="radio" name="heardFrom" value="YouTube" /><span>YouTube</span></label>
            <label class="chip-opt"><input type="radio" name="heardFrom" value="Other" /><span>Other</span></label>
          </div>
          <button type="submit" class="auth-submit">Continue</button>
        </form>
      </div>
    <% } else { %>
      <h1>Install the extension<br />to continue</h1>
      <p class="auth-sub">Works directly in your browser — capture meetings, no bots.</p>
      <div class="auth-panel onb-panel">
        <div class="onb-progress"><span class="done"></span><span class="done"></span><span class="done"></span></div>
        <ul class="onb-checks">
          <li>Capture every detail from the call</li>
          <li>Generate AI summaries and extract insights</li>
          <li>No intrusive bots — just seamless notes</li>
        </ul>
        <hr class="onb-hr" />
        <a class="auth-submit onb-install-btn" href="/install">Install Chrome Extension</a>
        <form method="POST" action="/onboarding" style="margin-top:12px">
          <input type="hidden" name="step" value="3" />
          <button type="submit" class="onb-later">I'll try it later</button>
        </form>
      </div>
    <% } %>
  </div>
  <script>
    document.querySelectorAll('.chip-opt input').forEach((input) => {
      input.addEventListener('change', () => {
        document.querySelectorAll('.chip-opt').forEach((l) => l.classList.remove('selected'));
        input.closest('.chip-opt').classList.add('selected');
      });
    });
  </script>
</body>
</html>
