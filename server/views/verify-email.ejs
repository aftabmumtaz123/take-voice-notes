<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify email · <%= settings?.siteName || 'AI Note Taker' %></title><link rel="stylesheet" href="/public/auth.css"></head>
<body class="auth-body"><div class="auth-shell"><a class="auth-logo" href="/"><span class="mark">✦</span><strong><%= settings?.siteName || 'AI Note Taker' %></strong></a><h1>Verify your email</h1><p class="auth-sub">We sent a 6-digit verification code to the email address you used for your account.</p><div class="auth-panel"><% if(error){%><div class="auth-error"><%= error %></div><%}%><% if(success){%><div class="auth-ok"><%= success %></div><%}%><form method="POST" action="/verify-email" class="auth-form"><input type="hidden" name="username" value="<%= username %>"><label class="field"><span class="field-ico">#</span><input name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" minlength="6" required placeholder="6-digit code" autocomplete="one-time-code" autofocus></label><button class="auth-submit" type="submit">Verify email</button></form><form method="POST" action="/verify-email/resend" style="margin-top:10px"><input type="hidden" name="username" value="<%= username %>"><button class="auth-secondary" type="submit">Send a new code</button></form><p class="auth-legal">The code is valid for 10 minutes. <a href="/login">Back to login</a></p></div></div></body></html>
