<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== "undefined" ? title + " · " : "" %>AI Note Taker</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet" />
  <link rel="stylesheet" href="/public/app.css" />
  <script>try{const key="ai-note-appearance-v2";const a=localStorage.getItem(key)||"light";document.documentElement.dataset.theme=a==="system"?(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"):a;document.documentElement.dataset.appearance=a;}catch(_){document.documentElement.dataset.theme="light";document.documentElement.dataset.appearance="light";}</script>
</head>
<body class="<%= typeof bodyClass !== "undefined" ? bodyClass : "" %>">
