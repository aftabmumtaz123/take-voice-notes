<%- include("partials/header", { title: "My Meetings", bodyClass: "app-shell" }) %>
<% const currentView = typeof view !== 'undefined' ? view : 'all'; %>
<% const redir = '/app/meetings?view=' + currentView + (q ? '&q=' + encodeURIComponent(q) : ''); %>
<div class="shell">
  <%- include("partials/sidebar", {
    user,
    activeNav: currentView === 'favorites' ? 'favorites' : (currentView === 'archived' ? 'archived' : 'meetings'),
    q: typeof q !== 'undefined' ? q : '',
    settings: typeof settings !== 'undefined' ? settings : null,
    usage: typeof usage !== 'undefined' ? usage : null
  }) %>
  <div class="main tactiq-main">
    <div class="top-banner">
      <span>Add the Chrome extension to use with Google Meet, Zoom, MS Teams and more.</span>
      <a class="banner-cta" href="/install">Get started – Install now</a>
    </div>

    <header class="main-top page-head">
      <div class="page-title-row">
        <span class="page-ico">▣</span>
        <h1><%= currentView === 'favorites' ? 'Favourites' : (currentView === 'archived' ? 'Archive' : 'My Meetings') %></h1>
      </div>
      <div class="main-actions">
        <a class="btn-primary" href="/account">API key</a>
        <a class="btn-ghost" href="/install">Install extension</a>
      </div>
    </header>

    <div class="toolbar">
      <form method="GET" action="/app/meetings" class="search-bar wide">
        <input type="hidden" name="view" value="<%= currentView %>" />
        <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Search for keywords, titles, and more…" />
      </form>
    </div>

    <div class="filter-row">
      <div class="view-tabs">
        <a class="view-tab <%= currentView === 'all' ? 'active' : '' %>" href="/app/meetings?view=all<%= q ? '&q=' + encodeURIComponent(q) : '' %>">Timeline</a>
        <a class="view-tab <%= currentView === 'favorites' ? 'active' : '' %>" href="/app/meetings?view=favorites<%= q ? '&q=' + encodeURIComponent(q) : '' %>">★ Favourites</a>
        <a class="view-tab <%= currentView === 'archived' ? 'active' : '' %>" href="/app/meetings?view=archived<%= q ? '&q=' + encodeURIComponent(q) : '' %>">Archive</a>
      </div>
      <div class="toolbar-meta">Sort: Newest first</div>
    </div>

    <% if (error) { %><div class="flash error"><%= error %></div><% } %>
    <% if (success) { %><div class="flash ok"><%= success %></div><% } %>

    <% if (!meetings || !meetings.length) { %>
      <div class="empty-hero card">
        <div class="empty-icon">▣</div>
        <h3>Unlock AI insights across your meeting history</h3>
        <p>Connect the Chrome extension, record a meeting, then search and summarize your notes.</p>
        <div class="empty-actions">
          <a class="btn-primary" href="/install">Install extension</a>
          <a class="btn-ghost" href="/account">Get API key</a>
        </div>
      </div>
    <% } else { %>
      <%
        function dayLabel(d) {
          if (!d) return 'Earlier';
          const dt = new Date(d);
          const today = new Date(); today.setHours(0,0,0,0);
          const that = new Date(dt); that.setHours(0,0,0,0);
          const diff = (today - that) / 86400000;
          if (diff < 1) return 'Today';
          if (diff < 2) return 'Yesterday';
          return dt.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
        }
        let lastLabel = '';
      %>
      <div class="meeting-groups">
        <% meetings.forEach(function(m) { %>
          <% const label = dayLabel(m.startedAt); const mins = Math.max(1, Math.round((m.duration || 0) / 60)); %>
          <% if (label !== lastLabel) { lastLabel = label; %>
            <div class="day-label"><%= label %></div>
          <% } %>
          <div class="meeting-row-wrap">
            <a class="meeting-row" href="/meetings/<%= m.externalId %>">
              <div class="meeting-dur">
                <strong><%= mins %>m</strong>
                <span><%= m.startedAt ? new Date(m.startedAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) : '—' %></span>
              </div>
              <div class="meeting-avatar"><%= (m.title || m.platform || 'M').charAt(0).toUpperCase() %></div>
              <div class="meeting-body">
                <strong>
                  <% if (m.isFavorite) { %><span class="fav-mark">★</span> <% } %>
                  <%= m.title || 'Untitled meeting' %>
                  <% if (m.isArchived) { %><span class="badge-archived">Archived</span><% } %>
                </strong>
                <span class="participants">
                  <%= m.platform || 'Manual' %> · <%= mins %> min
                  <% if (m.ai && m.ai.summary) { %> · <span class="ai-ready">✦ AI Summary ready</span><% } %>
                </span>
              </div>
            </a>
            <div class="meeting-actions">
              <form method="POST" action="/meetings/<%= m.externalId %>/favorite">
                <input type="hidden" name="redirect" value="<%= redir %>" />
                <button type="submit" class="icon-btn <%= m.isFavorite ? 'is-on' : '' %>" title="Favourite"><%= m.isFavorite ? '★' : '☆' %></button>
              </form>
              <form method="POST" action="/meetings/<%= m.externalId %>/archive">
                <input type="hidden" name="redirect" value="<%= redir %>" />
                <button type="submit" class="icon-btn" title="Archive">Archive</button>
              </form>
              <form method="POST" action="/meetings/<%= m.externalId %>/delete" onsubmit="return confirm('Delete this meeting permanently?');">
                <button type="submit" class="icon-btn danger" title="Delete">🗑</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
<%- include("partials/footer") %>
