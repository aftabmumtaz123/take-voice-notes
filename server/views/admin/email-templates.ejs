<%- include("../partials/header", { title: "Email Templates · Admin", bodyClass: "app-shell" }) %>
<div class="shell"><%- include("partials/admin-sidebar", { user, activeNav: "email-templates" }) %><div class="main admin-main">
<header class="main-top admin-hero"><div><p class="eyebrow">COMMUNICATION CENTER</p><h1>Email templates</h1><p class="admin-sub">Design every customer email once. Changes are persisted and used by the application immediately.</p></div><div class="main-actions"><a class="btn-primary" href="/admin/email-templates/new">+ New template</a></div></header>
<% if(success){%><div class="flash ok"><%=success%></div><%}%><% if(error){%><div class="flash error"><%=error%></div><%}%>
<div class="email-admin-intro"><div><strong>Gmail delivery</strong><span class="email-config-dot <%= gmailConfigured ? 'on' : 'off' %>"></span><%= gmailConfigured ? 'Configured' : 'Not configured' %></div><small>Set <code>GMAIL_SMTP_USER</code> and <code>GMAIL_SMTP_APP_PASSWORD</code> in your server environment. Never store the app password in a template.</small></div>
<div class="template-grid">
<% (templates||[]).forEach(function(t){ %><article class="template-card <%= t.isActive ? '' : 'inactive' %>"><div class="template-card-top"><span class="template-icon">✉</span><span class="template-category"><%= t.category %></span></div><h3><%= t.name %></h3><p><%= t.description || 'Application email template.' %></p><div class="template-subject"><span>Subject</span><strong><%= t.subject %></strong></div><div class="template-meta"><span><%= (t.variables||[]).length %> variables</span><span><%= t.isActive ? 'Active' : 'Disabled' %></span></div><div class="template-actions"><a class="btn-ghost" href="/admin/email-templates/<%= t._id %>/edit">Edit &amp; preview</a><form method="POST" action="/admin/email-templates/<%= t._id %>/toggle"><button class="btn-ghost" type="submit"><%= t.isActive ? 'Disable' : 'Enable' %></button></form></div></article><% }) %>
</div>
</div></div><%- include("../partials/footer") %>
