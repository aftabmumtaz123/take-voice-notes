<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Log in · <%= (settings && settings.siteName) || 'AI Note Taker' %></title>
  <link rel="stylesheet" href="/public/auth.css" />
</head>
<body class="auth-body">
  <div class="auth-shell">
    <a class="auth-logo" href="/">
      <span class="mark">✦</span>
      <strong><%= (settings && settings.siteName) || 'AI Note Taker' %></strong>
    </a>

    <h1>Log in or Sign up</h1>
    <p class="auth-sub">
      <%= (settings && settings.authSubtitle) || 'Turn meeting conversations into actionable outcomes. Log in or sign up to access transcripts, AI summaries, and workflows.' %>
    </p>

    <div class="auth-panel">
      <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
      <% if (success) { %><div class="auth-ok"><%= success %></div><% } %>

      <% if (typeof googleEnabled !== 'undefined' && googleEnabled) { %>
        <a class="auth-google" href="/api/google/start">
          <span class="g-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 7.9 3l5.7-5.7C34.2 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.5-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 12 24 12c3 0 5.8 1.1 7.9 3l5.7-5.7C34.2 6.1 29.3 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.3 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.1-3.5 5.5-6.5 6.6l6.2 5.2C38.7 37.1 44 31.5 44 24c0-1.3-.1-2.5-.4-3.5z"/></svg>
          </span>
          Continue with Google
        </a>
        <div class="auth-divider"><span>Or use username</span></div>
      <% } %>

      <form method="POST" action="/login" class="auth-form">
        <label class="field">
          <span class="field-ico">@</span>
          <input
            name="username"
            required
            minlength="3"
            maxlength="32"
            pattern="[a-zA-Z0-9_]+"
            placeholder="username"
            autocomplete="username"
            value="<%= typeof formUsername !== 'undefined' ? formUsername : '' %>"
          />
        </label>
        <label class="field">
          <span class="field-ico">•</span>
          <input
            name="passkey"
            type="password"
            required
            minlength="6"
            placeholder="Passkey"
            autocomplete="current-password"
          />
        </label>
        <button type="submit" class="auth-submit">Continue</button>
      </form>

      <div class="auth-divider"><span>New here?</span></div>
      <a class="auth-secondary" href="/register">Create an account</a>
      <p class="auth-legal">
        By continuing you agree to our terms of use.
        <a href="/">Back to home</a>
      </p>
    </div>
  </div>
</body>
</html>
