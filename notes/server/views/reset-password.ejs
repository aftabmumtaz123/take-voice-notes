<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Choose new passkey · <%= settings?.siteName || 'AI Note Taker' %></title><link rel="stylesheet" href="/public/auth.css"></head>
<body class="auth-body"><div class="auth-shell"><a class="auth-logo" href="/"><span class="mark">✦</span><strong><%= settings?.siteName || 'AI Note Taker' %></strong></a><h1>Choose a new passkey</h1><p class="auth-sub">Create a new passkey for your AI Note Taker account.</p><div class="auth-panel"><% if(error){%><div class="auth-error"><%= error %></div><%}%><% if(success){%><div class="auth-ok"><%= success %></div><%}%><% if(valid){%><form method="POST" action="/reset-password" class="auth-form"><input type="hidden" name="token" value="<%= token %>"><label class="field"><span class="field-ico">•</span><input name="passkey" type="password" minlength="6" maxlength="128" required placeholder="New passkey" autocomplete="new-password"></label><label class="field"><span class="field-ico">•</span><input name="passkey2" type="password" minlength="6" maxlength="128" required placeholder="Confirm new passkey" autocomplete="new-password"></label><button class="auth-submit" type="submit">Update passkey</button></form><% } else { %><div class="auth-error">This reset link is invalid or has expired. Please request a new one.</div><a class="auth-secondary" href="/forgot-password">Request a new link</a><% } %></div></div></body></html>
