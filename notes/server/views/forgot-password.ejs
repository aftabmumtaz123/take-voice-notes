<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Forgot passkey · <%= settings?.siteName || 'AI Note Taker' %></title><link rel="stylesheet" href="/public/auth.css"></head>
<body class="auth-body"><div class="auth-shell"><a class="auth-logo" href="/"><span class="mark">✦</span><strong><%= settings?.siteName || 'AI Note Taker' %></strong></a><h1>Reset your passkey</h1><p class="auth-sub">Enter your username or account email and we’ll send a secure reset link.</p><div class="auth-panel"><% if(error){%><div class="auth-error"><%= error %></div><%}%><% if(success){%><div class="auth-ok"><%= success %></div><%}%><form method="POST" action="/forgot-password" class="auth-form"><label class="field"><span class="field-ico">@</span><input name="identifier" type="text" required maxlength="200" placeholder="Username or email" autocomplete="username"></label><button class="auth-submit" type="submit">Email reset link</button></form><p class="auth-legal"><a href="/login">Back to login</a></p></div></div></body></html>
