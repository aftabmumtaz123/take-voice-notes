<%- include("../partials/header", { title: "Meetings · Admin", bodyClass: "app-shell" }) %>
<%
  function fmt(n) {
    n = Number(n) || 0;
    if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
    if (n >= 1e3) return n.toLocaleString();
    return String(n);
  }
  function fmtWhen(d) {
    if (!d) return '—';
    const dt = new Date(d);
    const now = new Date();
    const startToday = new Date(now); startToday.setHours(0,0,0,0);
    const startThat = new Date(dt); startThat.setHours(0,0,0,0);
    const diff = (startToday - startThat) / 86400000;
    const time = dt.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    if (diff < 1) return 'Today ' + time;
    if (diff < 2) return 'Yesterday ' + time;
    return dt.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
  }
  function aiStatus(m) {
    if (m.ai && m.ai.error) return { key: 'failed', label: '! Failed', cls: 'ai-failed' };
    if (m.ai && m.ai.summary) return { key: 'ready', label: '✓ AI Ready', cls: 'ai-ready-badge' };
    if (m.fullTranscript) return { key: 'pending', label: '— Not processed', cls: 'ai-pending' };
    return { key: 'none', label: '— No transcript', cls: 'ai-none' };
  }
  function platformLabel(p) {
    const s = String(p || 'Manual');
    if (/google\s*meet|meet\.google/i.test(s)) return 'Google Meet';
    if (/zoom/i.test(s)) return 'Zoom';
    if (/teams|microsoft/i.test(s)) return 'Microsoft Teams';
    if (/manual/i.test(s)) return 'Manual';
    return s;
  }
  const page = Number(pagination?.page || 1);
  const totalPages = Number(pagination?.totalPages || 1);
  const total = Number(pagination?.total || 0);
  const limit = Number(pagination?.limit || 25);
  const from = total === 0 ? 0 : (page - 1) * limit + 1;
  const to = Math.min(page * limit, total);
  const q = filters?.q || '';
  const platformFilter = filters?.platform || 'all';
  const aiFilter = filters?.ai || 'all';
  const dateFilter = filters?.date || 'all';
  const userFilter = filters?.user || '';
%>
<div class="shell">
  <%- include("partials/admin-sidebar", { user, activeNav: "meetings" }) %>
  <div class="main admin-main">
    <header class="main-top admin-hero">
      <div>
        <h1>Meetings</h1>
        <p class="admin-sub">Monitor meetings, transcripts, AI notes, and processing activity across all users.</p>
      </div>
      <div class="main-actions">
        <a class="btn-ghost" href="/admin/meetings/export.csv?q=<%= encodeURIComponent(q) %>&platform=<%= platformFilter %>&ai=<%= aiFilter %>&date=<%= dateFilter %>&user=<%= encodeURIComponent(userFilter) %>">Export</a>
        <a class="btn-ghost" href="/admin/meetings?q=<%= encodeURIComponent(q) %>&platform=<%= platformFilter %>&ai=<%= aiFilter %>&date=<%= dateFilter %>&user=<%= encodeURIComponent(userFilter) %>&page=<%= page %>">Refresh</a>
        <a class="btn-ghost" href="/admin">Overview</a>
      </div>
    </header>

    <% if (success) { %><div class="flash ok"><%= success %></div><% } %>
    <% if (error) { %><div class="flash error"><%= error %></div><% } %>

    <div class="admin-stats stats-4">
      <div class="stat-card rich">
        <span class="stat-label">Total Meetings</span>
        <strong><%= fmt(stats.total) %></strong>
        <% if (stats.growth != null) { %>
          <span class="stat-delta <%= stats.growth >= 0 ? 'up' : '' %>"><%= stats.growth >= 0 ? '+' : '' %><%= stats.growth %>% this month</span>
        <% } %>
      </div>
      <div class="stat-card rich">
        <span class="stat-label">Today</span>
        <strong><%= fmt(stats.today) %></strong>
      </div>
      <div class="stat-card rich">
        <span class="stat-label">AI Processed</span>
        <strong><%= fmt(stats.aiReady) %></strong>
        <span class="stat-delta up"><%= stats.aiRate %>% ready</span>
      </div>
      <div class="stat-card rich">
        <span class="stat-label">Processing Issues</span>
        <strong><%= fmt(stats.issues) %></strong>
        <span class="stat-delta"><%= stats.issues ? 'Needs review' : 'All clear' %></span>
      </div>
    </div>

    <form class="users-toolbar card" method="GET" action="/admin/meetings">
      <div class="users-search">
        <span class="search-icon" aria-hidden="true">🔍</span>
        <input type="search" name="q" value="<%= q %>" placeholder="Search meetings, users, titles…" />
      </div>
      <div class="users-filters">
        <select name="date">
          <option value="all" <%= dateFilter === 'all' ? 'selected' : '' %>>All dates</option>
          <option value="today" <%= dateFilter === 'today' ? 'selected' : '' %>>Today</option>
          <option value="7d" <%= dateFilter === '7d' ? 'selected' : '' %>>Last 7 days</option>
          <option value="30d" <%= dateFilter === '30d' ? 'selected' : '' %>>Last 30 days</option>
        </select>
        <input type="text" name="user" value="<%= userFilter %>" placeholder="User…" style="width:120px;border:1px solid var(--border);border-radius:10px;padding:9px 12px;font-size:13px" />
        <select name="platform">
          <option value="all" <%= platformFilter === 'all' ? 'selected' : '' %>>All platforms</option>
          <option value="Google Meet" <%= platformFilter === 'Google Meet' ? 'selected' : '' %>>Google Meet</option>
          <option value="Zoom" <%= platformFilter === 'Zoom' ? 'selected' : '' %>>Zoom</option>
          <option value="Microsoft Teams" <%= platformFilter === 'Microsoft Teams' ? 'selected' : '' %>>Microsoft Teams</option>
          <option value="Manual" <%= platformFilter === 'Manual' ? 'selected' : '' %>>Manual</option>
        </select>
        <select name="ai">
          <option value="all" <%= aiFilter === 'all' ? 'selected' : '' %>>All AI status</option>
          <option value="ready" <%= aiFilter === 'ready' ? 'selected' : '' %>>Completed</option>
          <option value="pending" <%= aiFilter === 'pending' ? 'selected' : '' %>>Not processed</option>
          <option value="failed" <%= aiFilter === 'failed' ? 'selected' : '' %>>Failed</option>
          <option value="none" <%= aiFilter === 'none' ? 'selected' : '' %>>No transcript</option>
        </select>
        <button type="submit" class="btn-ghost">Filter</button>
      </div>
    </form>

    <div class="table-wrap card users-table-card">
      <table class="users-table meetings-admin-table">
        <thead>
          <tr>
            <th>Meeting</th>
            <th>User</th>
            <th>Platform</th>
            <th>Duration</th>
            <th>AI Status</th>
            <th>Created</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!(meetings || []).length) { %>
            <tr><td colspan="7" class="empty-row">No meetings match your filters.</td></tr>
          <% } %>
          <% (meetings || []).forEach(function(m) {
            const st = aiStatus(m);
            const owner = m.owner || {};
            const mins = Math.max(0, Math.round((m.duration || 0) / 60));
            const title = (m.ai && m.ai.generatedTitle) || m.title || 'Untitled meeting';
          %>
            <tr>
              <td>
                <a class="meeting-title-link" href="/admin/meetings/<%= m.externalId %>">
                  <strong><%= title %></strong>
                </a>
              </td>
              <td>
                <% if (owner.username) { %>
                  <a class="user-cell compact" href="/admin/users/<%= owner.id %>">
                    <span class="user-avatar sm"><%= (owner.displayName || owner.username || '?').charAt(0).toUpperCase() %></span>
                    <span class="user-meta">
                      <strong>@<%= owner.username %></strong>
                      <% if (owner.displayName && owner.displayName !== owner.username) { %>
                        <span class="muted"><%= owner.displayName %></span>
                      <% } %>
                    </span>
                  </a>
                <% } else { %>
                  <span class="muted"><%= m.userId || '—' %></span>
                <% } %>
              </td>
              <td><span class="platform-pill"><%= platformLabel(m.platform) %></span></td>
              <td class="num"><%= mins ? mins + 'm' : '—' %></td>
              <td><span class="ai-status-badge <%= st.cls %>"><%= st.label %></span></td>
              <td class="muted" style="white-space:nowrap;font-size:12px"><%= fmtWhen(m.startedAt || m.createdAt) %></td>
              <td class="actions-cell">
                <div class="menu-wrap">
                  <button type="button" class="menu-trigger" aria-label="Actions">⋮</button>
                  <div class="menu-dropdown">
                    <a href="/admin/meetings/<%= m.externalId %>">View meeting</a>
                    <a href="/admin/meetings/<%= m.externalId %>#transcript">View transcript</a>
                    <a href="/admin/meetings/<%= m.externalId %>#summary">View AI summary</a>
                    <a href="/admin/meetings/<%= m.externalId %>#actions">View action items</a>
                    <% if (owner.id) { %><a href="/admin/users/<%= owner.id %>">View user</a><% } %>
                    <form method="POST" action="/admin/meetings/<%= m.externalId %>/analyze">
                      <button type="submit">Retry AI processing</button>
                    </form>
                    <form method="POST" action="/admin/meetings/<%= m.externalId %>/archive">
                      <button type="submit"><%= m.isArchived ? 'Unarchive' : 'Archive' %></button>
                    </form>
                    <form method="POST" action="/admin/meetings/<%= m.externalId %>/delete" onsubmit="return confirm('Delete this meeting permanently?');">
                      <button type="submit" class="danger">Delete meeting</button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1 || total > 0) { %>
      <div class="users-pagination">
        <span class="muted">Showing <%= from %>–<%= to %> of <%= fmt(total) %> meetings</span>
        <div class="pager">
          <% if (page > 1) { %>
            <a class="btn-ghost" href="/admin/meetings?q=<%= encodeURIComponent(q) %>&platform=<%= platformFilter %>&ai=<%= aiFilter %>&date=<%= dateFilter %>&user=<%= encodeURIComponent(userFilter) %>&page=<%= page - 1 %>">← Previous</a>
          <% } %>
          <% for (let p = 1; p <= totalPages && p <= 7; p++) { %>
            <a class="page-num <%= p === page ? 'active' : '' %>" href="/admin/meetings?q=<%= encodeURIComponent(q) %>&platform=<%= platformFilter %>&ai=<%= aiFilter %>&date=<%= dateFilter %>&user=<%= encodeURIComponent(userFilter) %>&page=<%= p %>"><%= p %></a>
          <% } %>
          <% if (page < totalPages) { %>
            <a class="btn-ghost" href="/admin/meetings?q=<%= encodeURIComponent(q) %>&platform=<%= platformFilter %>&ai=<%= aiFilter %>&date=<%= dateFilter %>&user=<%= encodeURIComponent(userFilter) %>&page=<%= page + 1 %>">Next →</a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>
<script>
  document.querySelectorAll('.menu-trigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wrap = btn.closest('.menu-wrap');
      document.querySelectorAll('.menu-wrap.open').forEach((w) => { if (w !== wrap) w.classList.remove('open'); });
      wrap.classList.toggle('open');
    });
  });
  document.addEventListener('click', () => {
    document.querySelectorAll('.menu-wrap.open').forEach((w) => w.classList.remove('open'));
  });
</script>
<%- include("../partials/footer") %>
