    </a>
    <a class="nav-item <%= activeNav === 'settings' ? 'active' : '' %>" href="/admin/settings">
      <span class="nav-ico">⚙</span> Settings
    </a>
    <a class="nav-item" href="/app">
      <span class="nav-ico">→</span> User App
    </a>
    <a class="nav-item" href="/logout">
      <span class="nav-ico">↪</span> Log out
    </a>
  </nav>
  <% if (typeof user !== "undefined" && user) { %>
  <div class="sidebar-user">
    <div class="avatar"><%= (user.displayName || user.username || "?").charAt(0).toUpperCase() %></div>
    <div class="sidebar-user-meta">
      <strong>@<%= user.username %></strong>
      <small>Administrator</small>
    </div>
  </div>
  <% } %>
