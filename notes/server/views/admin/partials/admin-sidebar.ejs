    <span class="logo">✦</span>
    <div>
      <strong>AI Notes</strong>
      <small>Admin control</small>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a class="nav-item <%= activeNav === 'dashboard' ? 'active' : '' %>" href="/admin">
      <span class="nav-ico">◆</span> Overview
    </a>
    <a class="nav-item <%= activeNav === 'users' ? 'active' : '' %>" href="/admin/users">
      <span class="nav-ico">☺</span> Users
    </a>
    <a class="nav-item <%= activeNav === 'meetings' ? 'active' : '' %>" href="/admin/meetings">
      <span class="nav-ico">⌂</span> Meetings
