    <a class="nav-item <%= activeNav === 'ai-notes' ? 'active' : '' %>" href="/admin/ai-notes">
      <span class="nav-ico">✦</span> AI Notes
    </a>
    <a class="nav-item <%= activeNav === 'transcriptions' ? 'active' : '' %>" href="/admin/transcriptions">
      <span class="nav-ico">≡</span> Transcriptions
    </a>
    <a class="nav-item <%= activeNav === 'plans' ? 'active' : '' %>" href="/admin/plans">
      <span class="nav-ico">$</span> Plans &amp; Billing
