<%- include("../partials/header", { title: (isNew ? 'New' : 'Edit') + " Email Template · Admin", bodyClass: "app-shell" }) %>
<div class="shell"><%- include("partials/admin-sidebar", { user, activeNav: "email-templates" }) %><div class="main admin-main">
<header class="main-top admin-hero"><div><p class="eyebrow">TEMPLATE EDITOR</p><h1><%= isNew ? 'Create email template' : template.name %></h1><p class="admin-sub">Edit the content on the left and see the email render update instantly on the right.</p></div><div class="main-actions"><a class="btn-ghost" href="/admin/email-templates">← Templates</a></div></header>
<% if(error){%><div class="flash error"><%=error%></div><%}%><% if(typeof success !== "undefined" && success){%><div class="flash ok"><%=success%></div><%}%>
<div class="email-editor-form">
<form method="POST" action="<%= isNew ? '/admin/email-templates' : '/admin/email-templates/' + template._id %>" class="email-editor-panel card">
<div class="form-grid-2"><label>Template key<input name="key" required maxlength="80" value="<%= template.key || '' %>" placeholder="billing-approved" <%= !isNew ? 'readonly' : '' %>></label><label>Name<input name="name" required maxlength="120" value="<%= template.name || '' %>" placeholder="Upgrade approved"></label><label>Category<input name="category" maxlength="60" value="<%= template.category || 'General' %>"></label><label>Subject<input id="emailSubject" name="subject" required maxlength="250" value="<%= template.subject || '' %>"></label></div>
<label>Preheader<input id="emailPreheader" name="preheader" maxlength="250" value="<%= template.preheader || '' %>"></label>
<label>Description<textarea name="description" rows="2"><%= template.description || '' %></textarea></label>
<label>Variables <span class="muted">comma separated</span><input name="variables" value="<%= (template.variables || []).join(', ') %>" placeholder="displayName, appUrl, requestId"></label>
<label>HTML body <span class="muted">Use {{variable}} tokens</span><textarea id="emailHtml" name="bodyHtml" rows="20" required><%= template.bodyHtml || '<div class="email-card"><h1>Hello {{displayName}}</h1><p>Write your professional message here.</p></div>' %></textarea></label>
<label>Plain-text fallback<textarea name="bodyText" rows="6"><%= template.bodyText || '' %></textarea></label>
<label class="check-line"><input type="checkbox" name="isActive" value="1" <%= template.isActive !== false ? 'checked' : '' %>> Active and available to the application</label>
<div class="editor-actions"><button class="btn-primary" type="submit">Save template</button><a class="btn-ghost" href="/admin/email-templates">Cancel</a></div>
</form>
<div class="email-preview-panel"><div class="preview-head"><div><span class="eyebrow">LIVE PREVIEW</span><h2>How the email looks</h2></div><button type="button" class="btn-ghost" id="refreshPreview">Refresh</button></div><div class="preview-meta"><div><span>To</span><strong>alex@example.com</strong></div><div><span>Subject</span><strong id="previewSubject"></strong></div></div><iframe id="emailPreview" title="Live email preview"></iframe><div class="token-help"><strong>Preview variables</strong><div class="token-pills"><% Object.keys(samples || {}).forEach(function(k){%><span>{{<%=k%>}}</span><%})%></div></div><% if(!isNew){ %><form method="POST" action="/admin/email-templates/<%= template._id %>/test" class="test-email-row"><input name="to" type="email" placeholder="test recipient@example.com" value="<%= user.email || '' %>"><button class="btn-ghost" type="submit">Send test email</button></form><% } %></div>
</div>
<script>
(function(){
 const vars=<%- JSON.stringify(samples || {}) %>;
 const subject=document.getElementById('emailSubject'), html=document.getElementById('emailHtml'), preview=document.getElementById('emailPreview'), out=document.getElementById('previewSubject');
 const esc=v=>String(v??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));
 function render(s){return String(s||'').replace(/{{\s*([a-zA-Z0-9_]+)\s*}}/g,(_,k)=>esc(vars[k]??'{{'+k+'}}'));}
 function update(){out.textContent=render(subject.value);const body=render(html.value);preview.srcdoc='<!doctype html><html><head><style>body{margin:0;background:#f4f6f8;color:#17202a;font-family:Arial,sans-serif}.email-wrap{padding:24px 12px}.email-shell{max-width:620px;margin:auto;background:#fff;border:1px solid #e5e7eb;border-radius:18px;overflow:hidden}.email-brand{padding:18px 22px;border-bottom:1px solid #eef0f3;font-weight:800}.email-brand span{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:9px;background:#111;color:#fff;margin-right:8px}.email-card{padding:28px}.email-card h1{font-size:27px;margin:8px 0 16px}.email-card p{font-size:15px;line-height:1.7;color:#46515d}.email-kicker{font-size:11px;letter-spacing:.12em;font-weight:800;color:#687382}.email-code{font-size:34px;letter-spacing:.28em;font-weight:800;text-align:center;padding:20px;background:#f5f7fa;border:1px dashed #cfd5dc;border-radius:14px;margin:22px 0}.email-button{display:inline-block;background:#111;color:#fff!important;text-decoration:none;padding:12px 18px;border-radius:10px;font-weight:800}.email-detail{display:grid;grid-template-columns:140px 1fr;gap:10px;padding:16px;background:#f7f8fa;border-radius:12px;margin:18px 0}.email-detail strong{color:#687382;font-size:12px}.email-callout{background:#f7f8fa;border-left:3px solid #111;padding:15px;border-radius:8px;line-height:1.6;white-space:pre-line}.muted{color:#7a8491!important;font-size:12px!important}</style></head><body><div class="email-wrap"><div class="email-shell"><div class="email-brand"><span>✦</span>AI Note Taker</div>'+body+'</div></div></body></html>';}
 subject.addEventListener('input',update);html.addEventListener('input',update);document.getElementById('refreshPreview').addEventListener('click',update);update();
})();
</script>
</div></div><%- include("../partials/footer") %>
