<%- include("partials/header", { title: "Team workspace", bodyClass: "app-shell" }) %>
<div class="shell">
  <%- include("partials/sidebar", { user, activeNav: "team", settings, usage, q: "" }) %>
  <div class="main team-page">
    <header class="main-top team-hero"><div><p class="eyebrow">TEAM WORKSPACE</p><h1><%= workspace.name %></h1><p class="admin-sub">Collaborate on meetings, shared notes, action items, decisions, and team intelligence.</p></div><a class="btn-ghost" href="/app/usage"><span class="material-symbols-outlined">arrow_back</span> Usage &amp; Plan</a></header>
    <% if (success) { %><div class="subscription-flash ok"><span class="material-symbols-outlined">check_circle</span><%= success %></div><% } %>
    <% if (error) { %><div class="subscription-flash error"><span class="material-symbols-outlined">error</span><%= error %></div><% } %>
    <section class="team-grid" id="analytics">
      <article class="team-card team-card-wide"><div class="team-card-kicker">WORKSPACE</div><div class="team-workspace-title"><span class="team-avatar"><span class="material-symbols-outlined">groups</span></span><div><h2><%= workspace.name %></h2><p><%= workspace.role %> · <%= members.length %>/<%= workspace.seatLimit %> seats used</p></div></div><div class="seat-progress"><span style="width:<%= Math.min(100, Math.round((members.length/workspace.seatLimit)*100)) %>%"></span></div></article>
      <article class="team-stat"><span class="material-symbols-outlined">video_camera_front</span><strong><%= analytics.meetings %></strong><small>Shared meetings</small></article>
      <article class="team-stat"><span class="material-symbols-outlined">schedule</span><strong><%= analytics.minutes %>m</strong><small>Shared minutes</small></article>
      <article class="team-stat"><span class="material-symbols-outlined">auto_awesome</span><strong><%= analytics.summaries %></strong><small>AI summaries</small></article>
      <article class="team-stat"><span class="material-symbols-outlined">checklist</span><strong><%= analytics.actions %></strong><small>Action items</small></article>
      <article class="team-stat"><span class="material-symbols-outlined">gavel</span><strong><%= analytics.decisions %></strong><small>Decisions</small></article>
    </section>
    <section class="team-section" id="members"><div class="team-section-head"><div><p class="eyebrow">TEAM MEMBERS</p><h2>People in this workspace</h2><p>Owners and admins can invite or remove members.</p></div></div>
      <div class="team-members-list"><% members.forEach(m => { %><div class="team-member-row"><div class="member-avatar"><%= (m.userId?.displayName || m.userId?.username || '?').charAt(0).toUpperCase() %></div><div class="member-info"><strong><%= m.userId?.displayName || m.userId?.username || 'Member' %></strong><small><%= m.userId?.email || '@'+(m.userId?.username||'') %></small></div><span class="role-pill <%= m.role %>"><%= m.role %></span><% if (['owner','admin'].includes(workspace.role) && m.role !== 'owner' && String(m.userId?._id)!==String(user.id)) { %><form method="POST" action="/billing/team/members/<%= m._id %>/remove" onsubmit="return confirm('Remove this member from the workspace?')"><input type="hidden" name="workspaceId" value="<%= workspace._id %>"><button class="icon-btn danger" title="Remove member"><span class="material-symbols-outlined">person_remove</span></button></form><% } %></div><% }) %></div>
      <% if (['owner','admin'].includes(workspace.role)) { %><div class="team-invite-panel"><div><strong>Invite a teammate</strong><p><%= Math.max(0, workspace.seatLimit-members.length) %> seats remaining.</p></div><form method="POST" action="/billing/team/invite" class="team-invite-form"><input type="hidden" name="workspaceId" value="<%= workspace._id %>"><input type="email" name="email" required placeholder="teammate@example.com"><select name="role"><option value="member">Member</option><option value="admin">Admin</option></select><button class="btn-primary" type="submit"><span class="material-symbols-outlined">person_add</span> Invite</button></form></div><% } %>
    </section>
    <section class="team-section"><div class="team-section-head"><div><p class="eyebrow">SHARED MEETINGS</p><h2>Meetings shared with the workspace</h2><p>Meetings stay private unless their owner explicitly shares them.</p></div></div>
      <% if (sharedMeetings.length) { %><div class="team-meeting-list"><% sharedMeetings.forEach(m => { %><a class="team-meeting-row" href="/meetings/<%= m.externalId %>"><span class="meeting-icon material-symbols-outlined">video_camera_front</span><span><strong><%= m.title || 'Untitled meeting' %></strong><small><%= m.startedAt ? new Date(m.startedAt).toLocaleString([], {dateStyle:'medium',timeStyle:'short'}) : '' %> · <%= Math.round(Number(m.duration||0)/60) %> min</small></span><span class="material-symbols-outlined">chevron_right</span></a><% }) %></div><% } else { %><div class="team-empty"><span class="material-symbols-outlined">share</span><strong>No shared meetings yet</strong><p>Open a meeting and choose “Share with workspace” when you're ready.</p></div><% } %>
    </section>
    <section class="team-section team-note"><span class="material-symbols-outlined">verified_user</span><div><strong>Team access</strong><p>Workspace data is preserved if the Team subscription ends. Members may lose Team workspace access until the subscription is reactivated.</p></div></section>
  </div>
</div>
<%- include("partials/footer") %>
