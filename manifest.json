{
  "manifest_version": 3,
  "name": "AI Note Taker",
  "version": "3.1.0",
  "description": "AI meeting transcription, post-meeting summaries, searchable history and meeting intelligence.",
  "permissions": [
    "storage",
    "offscreen",
    "tabs",
    "activeTab",
    "tabCapture",
    "windows",
    "alarms"
  ],
  "host_permissions": [
    "https://api.deepgram.com/*",
    "wss://api.deepgram.com/*",
    "https://streaming.assemblyai.com/*",
    "wss://streaming.assemblyai.com/*",
    "https://api.openai.com/*",
    "wss://api.openai.com/*",
    "http://localhost:4000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Note Taker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "127",
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "meeting-end-detector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
