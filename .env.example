# Developer-only configuration. Never commit this file.
# The build script injects these values into dist/runtime-config.js.
TRANSCRIBE_PROVIDER=assemblyai
TRANSCRIBE_FALLBACKS=deepgram,assemblyai,openai

DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

DEEPGRAM_MODEL=nova-3
ASSEMBLYAI_MODEL=universal-3-5-pro
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Local meeting dashboard/backend
BACKEND_URL=http://localhost:4000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
CLIENT_URL=http://localhost:3000

# Gmail SMTP (use a Google App Password; never commit the real value)
GMAIL_SMTP_USER=yourgmail@gmail.com
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
GMAIL_FROM_NAME=AI Note Taker
APP_BASE_URL=http://localhost:4000
